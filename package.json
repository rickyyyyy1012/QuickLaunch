{
  "name": "quicklaunch",
  "version": "0.1.0",
  "description": "Keyboard-first Spotlight-style launcher for Windows.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-renderer-assets.js",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "files": [
      "dist/**/*"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.1",
    "typescript": "^5.7.2"
  }
}
